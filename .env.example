# --- AI model (fine-tuned Phi-4-mini on vLLM/Modal) ---
# Local development: run `npm run mock-ai` and keep the defaults below.
AI_BASE_URL=http://localhost:8001
AI_API_KEY=
AI_MODEL=airecruitx
AI_TIMEOUT_MS=180000
AI_QGEN_TIMEOUT_MS=30000
AI_FINAL_WAIT_MS=240000
AI_CONCURRENCY=8
AI_JSON_SCHEMA=true
# keep retrying 502/503/504 (cold start) for this long; also the warm-up budget
AI_RETRY_WINDOW_MS=180000

# --- Reverse proxy ---
# Set to the exact number of trusted reverse-proxy hops in production (e.g. 1 behind one proxy).
# Leave at 0 when clients connect directly; incorrect values can make IP rate limits unreliable.
TRUST_PROXY_HOPS=0

# --- Score calibration (src/ai/calibration.ts) ---
# calibrated = min(10, round((raw * SCORE_SCALE + SCORE_OFFSET) * 10) / 10)
SCORE_SCALE=1.15
SCORE_OFFSET=0.8
# minimum per-criterion score when the verdict is correct (technical) / strong (basic)
SCORE_FLOOR_CORRECT=6

# --- Interview / certificate ---
INTERVIEW_BASIC_QUESTIONS=5
INTERVIEW_TECHNICAL_QUESTIONS=8
ROUND2_UNLOCK_SCORE=50
# time limits in minutes (server side; unanswered questions score 0 when time runs out)
BASIC_INTERVIEW_MINUTES=10
TECHNICAL_INTERVIEW_MINUTES=20
ORG_INTERVIEW_MINUTES=20
CERTIFICATE_PASS_SCORE=70

# --- Premium subscription (Stripe Billing) ---
# STRIPE_SECRET_KEY is shared with certificate payments.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint POST /api/billing/webhook (Stripe dashboard ->
# Developers -> Webhooks, or `stripe listen --forward-to localhost:5000/api/billing/webhook`).
# Events: checkout.session.completed, customer.subscription.created/updated/deleted,
# invoice.paid, invoice.payment_failed
STRIPE_WEBHOOK_SECRET=
# Optional: a recurring Price id from the Stripe dashboard. When empty, checkout creates
# the price from PREMIUM_PRICE_CENTS / PREMIUM_CURRENCY / PREMIUM_INTERVAL.
STRIPE_PREMIUM_PRICE_ID=
PREMIUM_PRICE_CENTS=2900
PREMIUM_CURRENCY=usd
# month | year
PREMIUM_INTERVAL=month
PREMIUM_TRIAL_DAYS=0
# days Premium is kept after a failed renewal while Stripe retries the card
PREMIUM_PAST_DUE_GRACE_DAYS=3
# Frontend URL; Stripe Checkout returns the candidate to <APP_BASE_URL>/candidate/billing
APP_BASE_URL=http://localhost:3000
