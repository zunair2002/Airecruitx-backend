# --- AI model (fine-tuned Phi-4-mini on vLLM/Modal) ---
# Local development: run `npm run mock-ai` and keep the defaults below.
AI_BASE_URL=http://localhost:8001
AI_API_KEY=
AI_MODEL=airecruitx
AI_TIMEOUT_MS=180000
AI_QGEN_TIMEOUT_MS=30000
AI_FINAL_WAIT_MS=240000
AI_CONCURRENCY=8
AI_JSON_SCHEMA=true
# keep retrying 502/503/504 (cold start) for this long; also the warm-up budget
AI_RETRY_WINDOW_MS=180000

# --- Redis (optional) ---
# Shared AI warm-up state + interview timers across instances. Leave empty to use memory.
REDIS_URL=redis://localhost:6379

# --- Score calibration (src/ai/calibration.ts) ---
# calibrated = min(10, round((raw * SCORE_SCALE + SCORE_OFFSET) * 10) / 10)
SCORE_SCALE=1.15
SCORE_OFFSET=0.8
# minimum per-criterion score when the verdict is correct (technical) / strong (basic)
SCORE_FLOOR_CORRECT=6

# --- Interview / certificate ---
INTERVIEW_BASIC_QUESTIONS=5
INTERVIEW_TECHNICAL_QUESTIONS=8
ROUND2_UNLOCK_SCORE=50
# time limits in minutes (server side; unanswered questions score 0 when time runs out)
BASIC_INTERVIEW_MINUTES=10
TECHNICAL_INTERVIEW_MINUTES=20
ORG_INTERVIEW_MINUTES=20
CERTIFICATE_PASS_SCORE=70
